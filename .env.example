# ==============================================================================
# Placement Co-pilot: Environment Configuration & API Keys
# ==============================================================================
# All third-party services provide 100% free developer tiers without credit card.
# If any key is missing, features gracefully fall back to local demo stores and
# deterministic heuristic engines.
# ==============================================================================

# ─── 1. Supabase Database & Authentication (Optional for Demo Mode) ───────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_DATA_MODE=demo

# ─── 2. Google Gemini AI Engine (Optional - Primary AI Model) ─────────────────
# Get free key from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key

# ─── 3. Groq AI Engine (Optional - Ultra-Fast Fallback AI) ────────────────────
# Get free key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# ─── 4. Job Discovery APIs (Server-side only — NEVER prefix with NEXT_PUBLIC_) ─
OPENWEBNINJA_API_KEY=your_openwebninja_api_key_here
HIMALAYAS_API_KEY=your_himalayas_api_key_here

# ─── 5. Python Document Parser Microservice (Optional) ────────────────────────
# Default local endpoint for the companion FastAPI parser:
PYTHON_PARSER_URL=http://127.0.0.1:8000
